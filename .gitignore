# Build output.
# Leading slash matters: a bare "assay" would also ignore the cmd/assay/ source
# directory, since gitignore patterns without a slash match at any depth.
/bin/
/dist/
/assay
/assay.exe

# Test / coverage
*.test
*.out
coverage.*

# Local vulnerability DB and scan artifacts
/.assay/
*.sbom.json
*.cdx.json
*.spdx.json
# ...but SBOM fixtures under any testdata/ are committed on purpose.
# The leading **/ matters: a pattern containing a mid-string slash is anchored
# to the repo root, so "!testdata/**/*.json" would only rescue a root-level
# testdata/ and silently keep ignoring internal/<pkg>/testdata/ — where the
# fixtures actually live.
!**/testdata/**/*.json

# Scratch state for plan execution: ledgers, briefs, review packages.
# Git history is the durable record; this is working memory.
/.superpowers/

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Never commit credentials or signing keys
*.pem
*.key
!testdata/**/*.key
.env

# Windows shell crash dumps, which land in the working directory
*.stackdump
.claude/
